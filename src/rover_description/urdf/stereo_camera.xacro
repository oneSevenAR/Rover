<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="stereo_rig">

  <!-- ========================================== -->
  <!-- PLUGINS                                    -->
  <!-- ========================================== -->
  
  <!-- Enable Gazebo Sim Sensors Plugin -->
  <gazebo>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- Enable Gazebo Diff Drive Plugin -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom_raw</odom_topic> <!-- changed from odom and tf-->
      <tf_topic>/tf_gazebo</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>chassis</child_frame_id>
    </plugin>
  </gazebo>

  <!-- ========================================== -->
  <!-- BASE CHASSIS & CASTER                      -->
  <!-- ========================================== -->
  
  <!-- Chassis Link (Shifted up to accommodate wheels) -->
  <link name="chassis">
    <inertial>
      <mass value="2.0"/>
      <!-- Shifted center of mass up -->
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Frictionless Caster Wheel (Rear) -->
  <joint name="caster_joint" type="fixed">
    <parent link="chassis"/>
    <child link="caster_link"/>
    <origin xyz="-0.15 0 0.04" rpy="0 0 0"/>
  </joint>
  
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <!-- Remove friction from the caster so it glides smoothly -->
  <gazebo reference="caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- ========================================== -->
  <!-- DRIVE WHEELS (MACRO)                       -->
  <!-- ========================================== -->
  
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.04"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="chassis"/>
      <child link="${prefix}_wheel"/>
      <!-- Wheels mounted forward and out to the sides -->
      <origin xyz="0.1 ${y_reflect * 0.17} 0.08" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" y_reflect="1" />
  <xacro:wheel prefix="right" y_reflect="-1" />

  <!-- ========================================== -->
  <!-- STEREO CAMERAS                             -->
  <!-- ========================================== -->

  <!-- Camera Joint & Link -->
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <!-- Lifted slightly to match the new chassis height -->
    <origin xyz="0.2 0 0.20" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.14 0.03"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Optical Frame -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="left_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="left_camera_optical_frame"/>

  <!-- Left Camera Sensor -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="left_camera">
      <update_rate>30.0</update_rate>
      <topic>/stereo/left/image_raw</topic>
      <gz_frame_id>left_camera_optical_frame</gz_frame_id>
      <camera name="left">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Right Camera Sensor -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="right_camera">
      <update_rate>2.0</update_rate>
      <topic>/stereo/right/image_raw</topic>
      <pose>0 -0.1 0 0 0 0</pose>
      <gz_frame_id>left_camera_optical_frame</gz_frame_id>
      <camera name="right">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ========================================== -->
  <!-- IMU SENSOR                                 -->
  <!-- ========================================== -->
  <link name="imu_link"/>
  
  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu/data</topic>
    </sensor>
  </gazebo>

</robot>